{{- /* One section per year at /YYYY/ (hugo.toml [permalinks.section]), to keep Lokka's year archive URLs. A section (not a page) so it can paginate like Lokka did. The first post is from 2014. */ -}}
{{ range seq 2014 now.Year }}
  {{ $y := string . }}
  {{ $.AddPage (dict "path" $y "title" $y "kind" "section" "params" (dict "year" $y)) }}
{{ end }}
