{{- /* Same shape as Lokka's sitemap (public/lokka/sitemap.builder): the top page with changefreq/priority, then posts newest first. Lokka listed only the latest 10; this lists every post. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
{{ $posts := (where site.RegularPages "Section" "posts").ByDate.Reverse }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.BaseURL }}</loc>
    {{ with index $posts 0 }}<lastmod>{{ partial "feed-time.html" (dict "page" . "t" .Lastmod) }}</lastmod>{{ end }}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  {{ range $posts }}
  <url>
    <loc>{{ partial "post-permalink.html" . }}</loc>
    <lastmod>{{ partial "feed-time.html" (dict "page" . "t" .Lastmod) }}</lastmod>
  </url>
  {{ end }}
</urlset>
